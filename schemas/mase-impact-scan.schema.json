{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mase.dev/schemas/mase-impact-scan.schema.json",
  "title": "MASE impact scanner adapter output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapter", "inputs", "change_points", "callers", "implicit_channels", "boundaries", "terminations", "diagnostics"],
  "properties": {
    "schema": {"const": "mase-impact-scan/v1"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rules_digest", "confidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rules_digest": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "change_points": {"type": "array", "items": {"type": "object"}},
    "callers": {"type": "array", "items": {"type": "object"}},
    "implicit_channels": {"type": "array", "items": {"type": "object"}},
    "boundaries": {"type": "array", "items": {"type": "object"}},
    "terminations": {"type": "array", "items": {"type": "object"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
