{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mase.dev/schemas/mase-test-manifest.schema.json",
  "title": "MASE test selection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tests"],
  "properties": {
    "schema": {"const": "mase-test-manifest/v1"},
    "tests": {
      "type": "array",
      "items": {"$ref": "#/$defs/test"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tier", "runner", "selectors", "paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "tier": {
          "enum": ["unit", "contract", "integration", "ui_contract", "p0_journey", "p1_regression"]
        },
        "runner": {"type": "string", "minLength": 1},
        "selectors": {"$ref": "#/$defs/nonEmptyStrings"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths": {"$ref": "#/$defs/nonEmptyStrings"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"tier": {"const": "p0_journey"}}, "required": ["tier"]},
          "then": {
            "required": ["acceptance", "capabilities"],
            "properties": {"capabilities": {"minItems": 1}}
          }
        }
      ]
    }
  }
}
